# ---------------------------------------------------------------------------
# KIDS MODA — environment
# Copy to .env.local and fill in. The site runs fully without these values,
# using the local seed catalogue (lib/commerce/seed.ts). As soon as the
# Supabase keys are present the app switches to the database automatically.
# ---------------------------------------------------------------------------

# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://kidsmoda.com

# Server only — NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
